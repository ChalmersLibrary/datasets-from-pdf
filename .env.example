# vLLM backend settings (used with --backend vllm).
# Copy to .env and fill in. Variables already set in the shell take precedence.
VLLM_BASE_URL=http://localhost:4000
VLLM_API_KEY=
VLLM_MODEL=qwen3.5
VLLM_TIMEOUT=300
VLLM_ENABLE_THINKING=0
# Retries for timeouts, connection errors and 429/5xx responses (both backends).
VLLM_RETRIES=4
